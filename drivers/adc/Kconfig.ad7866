config ADC_AD7866
	bool "Analog Devices AD7866 ADC"
	default y
	depends on DT_HAS_ADI_AD7866_ENABLED
	select SPI
	select GPIO
	help
	  Enable the driver for the Analog Devices AD7866 dual 12-bit,
	  1 MSPS, 2-channel simultaneous sampling SAR ADC.

config ADC_AD7866_ACQUISITION_THREAD_INIT_PRIO
	int "ADC data acquisition thread priority"
	default 0
	depends on ADC_AD7866 && ADC_ASYNC

config ADC_AD7866_ACQUISITION_THREAD_STACK_SIZE
	int "Stack size for the ADC data acquisition thread"
	default 512
	depends on ADC_AD7866 && ADC_ASYNC
	help
	  Size of the stack used for the internal data acquisition
	  thread.
