&spi0 {
	ad7866: ad7866@0 {
		compatible = "adi,ad7866";
		reg = <0>;
		spi-max-frequency = <2000000>;
		a0-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		range-gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		avdd-mv = <5000>;
		#io-channel-cells = <1>;
	};
};
